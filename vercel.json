{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/company",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/company/",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terms/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/areas/:path+",
      "destination": "https://tashikame.app/areas/:path+",
      "permanent": true
    },
    {
      "source": "/situations/:path+",
      "destination": "https://tashikame.app/situations/:path+",
      "permanent": true
    },
    {
      "source": "/areas",
      "destination": "https://tashikame.app/articles",
      "permanent": true
    },
    {
      "source": "/areas/",
      "destination": "https://tashikame.app/articles",
      "permanent": true
    },
    {
      "source": "/situations",
      "destination": "https://tashikame.app/articles",
      "permanent": true
    },
    {
      "source": "/situations/",
      "destination": "https://tashikame.app/articles",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
